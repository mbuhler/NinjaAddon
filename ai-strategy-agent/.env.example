OPENROUTER_API_KEY=your_key_here
GEMINI_API_KEY=your_gemini_key
PROVIDER=openrouter
MODEL=openrouter/gpt-4

REDIS_MEMORY_ENABLED=true
LLM_CACHE_ENABLED=true
REDIS_TTL_MEMORY=1800
REDIS_TTL_CACHE=86400

ENABLE_DISCORD_NOTIFICATIONS=false
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here

EXPORT_STRATEGY_SUMMARY=true
EXPORT_DAILY_ENABLED=true
EXPORT_DAILY_TIME=17:00
EXPORT_WEEKLY_ENABLED=true
EXPORT_WEEKLY_DAY=saturday
EXPORT_WEEKLY_TIME=12:00
EXPORT_TARGET=discord
DISCORD_EXPORT_CHANNEL_ID=YOUR_CHANNEL_ID
EXPORT_LOCAL_COPY=true
EXPORT_LOCAL_DIR=exports
